#!/usr/bin/env python3
"""`gh` shim for integration tests: pull requests live in $OMAC_GH_STATE/prs.json, every call is logged to
$OMAC_GH_STATE/calls.log, and $OMAC_GH_STATE/behavior.json can make `pr merge` fail ({"merge": "fail"}), succeed without merging ("noop"), queue ("queue"), or make
`pr view` fail ({"view": "fail"}). A pull request entry may carry "draft", "state" (e.g. "CLOSED"), "merge_state", "auto_merge", "merged_at".

Supports exactly what OMAC calls: `gh pr view <url> --json ...`, `gh pr merge <url> ...` and `gh pr checks <url>` ({"checks": "fail"} makes it fail), `gh pr create` (for real
agents in the smoke run), plus the test-only
`gh __push <url>` that a scripted worker uses to move the PR head like a real push would."""
import hashlib, json, os, sys, time
from pathlib import Path

root = Path(os.environ["OMAC_GH_STATE"])
args = sys.argv[1:]
with (root / "calls.log").open("a") as log:
    log.write(json.dumps({"args": args, "at": time.time()}) + "\n")
prs_path, behavior_path = root / "prs.json", root / "behavior.json"
prs = json.loads(prs_path.read_text()) if prs_path.exists() else {}
behavior = json.loads(behavior_path.read_text()) if behavior_path.exists() else {}
if args[:2] == ["pr", "view"] and len(args) > 2:
    if behavior.get("view") == "fail":
        sys.exit("gh: could not reach api.github.com (temporary)")
    url, entry = args[2], prs.get(args[2], {})
    print(json.dumps({"isDraft": bool(entry.get("draft")), "state": entry.get("state") or ("MERGED" if entry.get("merged") else "OPEN"),
                      "headRefOid": hashlib.sha1(f"{url}#{entry.get('pushes', 0)}".encode()).hexdigest(),
                      "mergeStateStatus": entry.get("merge_state", "CLEAN"),
                      "mergedAt": entry.get("merged_at"), "autoMergeRequest": {"enabledBy": "shim"} if entry.get("auto_merge") else None}))
elif args[:2] == ["pr", "merge"] and len(args) > 2:
    if behavior.get("merge") == "fail":
        sys.exit("merge refused")
    entry = prs.get(args[2], {})
    if behavior.get("merge") == "noop":          # the command succeeds but the pull request stays open
        print("merge requested")
    elif behavior.get("merge") == "queue":       # accepted into the merge queue: pending, not merged
        prs[args[2]] = {**entry, "auto_merge": True}
        prs_path.write_text(json.dumps(prs))
        print("merge queued")
    else:
        prs[args[2]] = {**entry, "merged": True, "merged_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
        prs_path.write_text(json.dumps(prs))
        print("merged")
elif args[:2] == ["pr", "checks"] and len(args) > 2:
    if behavior.get("checks") == "fail":
        sys.exit("check failed: ci/build")
    print("all checks passed")
elif args[:2] == ["pr", "create"]:
    number = len(prs) + 1
    url = f"https://github.com/example/repo/pull/{number}"
    prs[url] = {"pushes": 1}
    prs_path.write_text(json.dumps(prs))
    print(url)
elif args[:1] == ["__push"] and len(args) > 1:
    entry = prs.setdefault(args[1], {})
    entry["pushes"] = entry.get("pushes", 0) + 1
    prs_path.write_text(json.dumps(prs))
else:
    sys.exit(f"gh shim: unsupported command {args}")
